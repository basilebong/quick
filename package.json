{
  "name": "quick",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "license": "Elastic-2.0",
  "scripts": {
    "hooks:install": "lefthook install",
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --hot apps/server/src/index.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "pnpm --filter @quick/web build",
    "typecheck": "tsc -b",
    "test": "bun test",
    "check": "biome check .",
    "check:source": "bun ./scripts/check-source.ts",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun ./scripts/migrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/react": "19.3.0",
    "bun-types": "1.4.2",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "lefthook": "2.1.15",
    "oxc-parser": "0.152.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.25.0": ">=0.25.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-p2fr-6hmx-4528"
      ]
    }
  }
}
